# İletiMerkezi API credentials.
# Both values are issued (already paired) from:
#   panel.iletimerkezi.com → Settings → Security → API Access
# Copy them AS-IS — the panel precomputes the hash; do NOT hash anything yourself.
# Also enable "Allow API access" under Settings → Security, or the API returns 401.
ILETIMERKEZI_API_KEY=
ILETIMERKEZI_API_HASH=

# Optional: default sender header (başlık) used when a tool call omits `sender`.
# Must be BTK-approved (3–11 chars). Use APITEST for sandbox sends.
# ILETIMERKEZI_SENDER=

# Migration aliases (pre-2.0 configs): ILETI_API_KEY / ILETI_API_HASH are also accepted.
